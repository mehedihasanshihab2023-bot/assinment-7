# ── BetterAuth Social Login (optional) ─────────────────────────────
# Without these keys the app still works with email/password login.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── BetterAuth secret ──────────────────────────────────────────────
# Any long random string. A dev fallback is used if omitted.
BETTER_AUTH_SECRET=

# ── SQLite database path ───────────────────────────────────────────
# Defaults to ./bazar-dor.db locally and /tmp/bazar-dor.db on Vercel.
SQLITE_PATH=
